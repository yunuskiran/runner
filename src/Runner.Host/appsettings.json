{
  "Storage": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=data/runner.db;Default Timeout=30",
    "Initialize": false
  },
  "Runner": {
    "Concurrency": 4,
    "PollMilliseconds": 1000,
    "LeaseSeconds": 60,
    "HeartbeatSeconds": 15,
    "JobTimeoutSeconds": 300,
    "RetentionDays": 14,
    "WorkerEnabled": true,
    "MaxIdlePollSeconds": 30,
    "NodeHeartbeatSeconds": 10,
    "SchedulerSeconds": 5,
    "MaintenanceSeconds": 300,
    "MaxPendingJobs": 100000,
    "Queues": [
      "default"
    ],
    "Tags": []
  },
  "Plugins": [
    "plugins/Runner.SamplePlugin.dll"
  ],
  "AllowedHosts": "localhost;127.0.0.1",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Scripting": {
    "Enabled": false
  },
  "Operations": {
    "Connections": {},
    "Applications": {}
  },
  "Alerts": {
    "DeliveryEnabled": true
  },
  "Packages": {
    "Enabled": true,
    "CacheDirectory": "data/package-cache"
  },
  "Execution": {
    "Isolation": "Process"
  }
}
